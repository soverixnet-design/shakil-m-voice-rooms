rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Only the verified owner account can administer this application.
    function isAdmin() {
      return isSignedIn() && request.auth.token.email_verified == true &&
        request.auth.token.email == 'yfastvpn@gmail.com';
    }

    // User profiles & wallet
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() || (isOwner(userId) &&
        (!('role' in request.resource.data) || request.resource.data.role == 'user'));
      allow update: if isAdmin() || (isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']));
      allow delete: if isAdmin();
    }

    // Transactions ledger
    match /transactions/{transactionId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        resource == null || 
        resource.data.userId == request.auth.uid || 
        resource.data.senderId == request.auth.uid || 
        resource.data.receiverId == request.auth.uid
      );
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Voice rooms
    match /rooms/{roomId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (resource.data.hostId == request.auth.uid || request.resource.data.hostId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && (resource.data.hostId == request.auth.uid || isAdmin());
    }

    // Global System Config
    match /system/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admin collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
