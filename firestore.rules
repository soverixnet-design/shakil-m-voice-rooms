rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function owner() { return signed() && request.auth.token.get('email_verified', false) == true && request.auth.token.get('email', '') == 'yfastvpn@gmail.com'; }
    function self(uid) { return signed() && request.auth.uid == uid; }
    function active() { return signed() && (!exists(/databases/$(database)/documents/users/$(request.auth.uid)) || !(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', 'active') in ['banned', 'archived'])); }
    function permission(name) { return active() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('active', false) == true && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('permissions', {}).get(name, false) == true; }
    function staff(name) { return owner() || permission(name); }
    function roomOwner(id) { return active() && get(/databases/$(database)/documents/rooms/$(id)).data.hostId == request.auth.uid; }
    function roomAdmin(id) { return roomOwner(id) || (active() && exists(/databases/$(database)/documents/rooms/$(id)/roles/$(request.auth.uid)) && get(/databases/$(database)/documents/rooms/$(id)/roles/$(request.auth.uid)).data.role == 'admin'); }
    function mayEnterRoom(id) { return id == null || id == '' || !exists(/databases/$(database)/documents/rooms/$(id)/controls/$(request.auth.uid)) || get(/databases/$(database)/documents/rooms/$(id)/controls/$(request.auth.uid)).data.get('blocked',false) != true; }
    // All three documents must commit together. A receipt ID cannot be reused.
    function validSellerTransfer(id) {
      let path = /databases/$(database)/documents/sellerTransfers/$(id);
      let data = getAfter(path).data;
      let walletPath = /databases/$(database)/documents/sellerWallets/$(request.auth.uid);
      let userPath = /databases/$(database)/documents/users/$(data.receiverId);
      let wallet = get(walletPath).data;
      let recipient = get(userPath).data;
      let nextWallet = getAfter(walletPath).data;
      let nextUser = getAfter(userPath).data;
      return permission('seller') && !exists(path) && data.keys().hasOnly(['type','sellerId','receiverId','receiverPublicId','amount','sellerBefore','sellerAfter','receiverBefore','receiverAfter','createdAt']) && data.type == 'transfer' && data.sellerId == request.auth.uid && data.receiverId != request.auth.uid && data.amount is int && data.amount > 0 && data.amount <= wallet.balance && data.createdAt == request.time && !(recipient.get('status','active') in ['banned','archived']) && data.receiverPublicId == recipient.id && data.sellerBefore == wallet.balance && data.sellerAfter == wallet.balance - data.amount && data.receiverBefore == recipient.coins && data.receiverAfter == recipient.coins + data.amount && nextWallet.balance == data.sellerAfter && nextWallet.lastTransferId == id && nextWallet.diff(wallet).affectedKeys().hasOnly(['balance','lastTransferId']) && nextUser.coins == data.receiverAfter && nextUser.lastSellerTransfer == id && nextUser.diff(recipient).affectedKeys().hasOnly(['coins','lastSellerTransfer']);
    }
    match /users/{uid} {
      allow read: if active() || self(uid);
      allow create: if owner() || (self(uid) && active() && request.resource.data.get('role','user') == 'user' && request.resource.data.get('status','active') == 'active' && request.resource.data.get('email','') == request.auth.token.get('email',''));
      allow update: if owner() || (self(uid) && active() && mayEnterRoom(request.resource.data.get('currentRoomId',null)) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role','status','email','lastSellerTransfer'])) || (permission('moderate') && resource.data.get('email','') != 'yfastvpn@gmail.com' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) && request.resource.data.status in ['active','banned']) || (permission('seller') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['coins','lastSellerTransfer']) && validSellerTransfer(request.resource.data.get('lastSellerTransfer','missing')));
      allow delete: if owner();
    }
    match /admins/{uid} { allow read: if owner() || self(uid); allow write: if owner(); }
    match /sellerWallets/{uid} {
      allow read: if owner() || (self(uid) && active());
      allow create, delete: if owner();
      allow update: if owner() || (self(uid) && permission('seller') && request.resource.data.balance is int && request.resource.data.balance >= 0 && validSellerTransfer(request.resource.data.get('lastTransferId','missing')));
    }
    match /sellerTransfers/{id} {
      allow read: if owner() || (active() && (resource.data.get('sellerId','') == request.auth.uid || resource.data.get('receiverId','') == request.auth.uid));
      allow create: if owner() || (permission('seller') && validSellerTransfer(id));
      allow update, delete: if false;
    }
    match /transactions/{id} {
      allow read: if owner() || (active() && (resource == null || resource.data.get('userId','') == request.auth.uid || resource.data.get('senderId','') == request.auth.uid || resource.data.get('receiverId','') == request.auth.uid));
      allow create: if active();
      allow update, delete: if owner();
    }
    match /rooms/{id} {
      allow read: if true;
      allow create: if owner() || (active() && request.resource.data.hostId == request.auth.uid);
      allow update: if owner() || (active() && resource.data.hostId == request.auth.uid && request.resource.data.hostId == resource.data.hostId);
      allow delete: if owner() || (active() && resource.data.hostId == request.auth.uid);
    }
    match /rooms/{roomId}/roles/{uid} {
      allow read: if active();
      allow create, update: if roomOwner(roomId) && uid != get(/databases/$(database)/documents/rooms/$(roomId)).data.hostId && request.resource.data.keys().hasOnly(['role']) && request.resource.data.role == 'admin';
      allow delete: if roomOwner(roomId);
    }
    match /rooms/{roomId}/controls/{uid} {
      allow read: if active();
      allow create, update: if roomAdmin(roomId) && uid != get(/databases/$(database)/documents/rooms/$(roomId)).data.hostId && (roomOwner(roomId) || !exists(/databases/$(database)/documents/rooms/$(roomId)/roles/$(uid))) && request.resource.data.keys().hasOnly(['muted','blocked']) && request.resource.data.muted is bool && request.resource.data.blocked is bool;
      allow delete: if roomOwner(roomId);
    }
    // Public room animation mirrors a newly committed private gift receipt.
    match /rooms/{roomId}/giftEvents/{giftId} {
      allow read: if active();
      allow create: if active()
        && request.resource.data.keys().hasOnly([
          'type','senderId','receiverId','userId','senderName',
          'receiverName','receiverPublicId','receiverAvatar',
          'giftName','emoji','giftImage','quantity','cost','roomId','createdAt'
        ])
        && request.resource.data.type == 'gift_sent'
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.roomId == roomId
        && request.resource.data.giftImage is string
        && request.resource.data.giftImage.size() <= 600000
        && (request.resource.data.giftImage == '' || request.resource.data.giftImage.matches('data:image/(png|jpeg|webp|gif);base64,[A-Za-z0-9+/]*={0,2}'))
        && request.resource.data.quantity is int
        && request.resource.data.quantity > 0
        && request.resource.data.quantity <= 999
        && request.resource.data.cost is int
        && request.resource.data.cost > 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.receiverPublicId == get(/databases/$(database)/documents/users/$(request.resource.data.receiverId)).data.get('id',request.resource.data.receiverId)
        && !exists(/databases/$(database)/documents/transactions/$(giftId))
        && getAfter(/databases/$(database)/documents/transactions/$(giftId)).data == request.resource.data
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.coins
          == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.coins - request.resource.data.cost
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.coins >= 0
        && !(get(/databases/$(database)/documents/users/$(request.resource.data.receiverId)).data.get('status','active') in ['banned','archived']);
      allow update, delete: if false;
    }

    match /system/{id} {
      allow read: if true;
      allow write: if owner();
      allow create: if permission('content') && ((id == 'notices' && request.resource.data.keys().hasOnly(['items'])) || (id == 'config' && request.resource.data.keys().hasOnly(['bn','customGifts'])));
      allow update: if permission('content') && ((id == 'notices' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['items'])) || (id == 'config' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bn','customGifts'])));
    }
    match /assets/{id} {
      allow read: if true;
      allow create, update: if staff('content') && request.resource.data.kind in ['frame','entry','banner','gift'] && (request.resource.data.kind != 'gift' || (request.resource.data.price is int && request.resource.data.price > 0)) && request.resource.data.name is string && request.resource.data.name.size() <= 80 && request.resource.data.image is string && request.resource.data.image.size() <= 600000 && request.resource.data.image.matches('data:image/(png|jpeg|webp|gif);base64,[A-Za-z0-9+/]*={0,2}');
      allow delete: if staff('content');
    }
    match /supportTickets/{uid} {
      allow read: if (self(uid) && active()) || staff('support');
      allow create, update: if ((self(uid) && active()) || staff('support')) && request.resource.data.keys().hasOnly(['userId','name','updatedAt','lastMessage','status']) && request.resource.data.userId == uid && request.resource.data.name is string && request.resource.data.lastMessage is string && request.resource.data.lastMessage.size() <= 120;
      allow delete: if owner();
      match /messages/{id} {
        allow read: if (self(uid) && active()) || staff('support');
        allow create: if active() && request.resource.data.keys().hasOnly(['senderId','kind','text','image','createdAt']) && request.resource.data.senderId == request.auth.uid && request.resource.data.createdAt == request.time && request.resource.data.text is string && request.resource.data.text.size() <= 3000 && request.resource.data.image is string && request.resource.data.image.size() <= 600000 && (request.resource.data.image == '' || request.resource.data.image.matches('data:image/(png|jpeg|webp|gif);base64,[A-Za-z0-9+/]*={0,2}')) && ((self(uid) && request.resource.data.kind == 'customer') || (staff('support') && request.resource.data.kind == 'staff'));
        allow update, delete: if owner();
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
