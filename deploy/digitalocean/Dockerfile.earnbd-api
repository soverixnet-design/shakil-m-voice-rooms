# Isolated EarnBD API on the Akira DigitalOcean host.
# Reuses the existing EarnBD Supabase ledger, and never touches Akira Postgres.
FROM node:22-alpine
ENV NODE_ENV=production PORT=10000
WORKDIR /srv/earnbd
COPY functions/package.json functions/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts
COPY functions/ ./
EXPOSE 10000
CMD ["node","render-server.js"]
